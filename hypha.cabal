cabal-version:      3.4
name:               hypha
version:            0.0.0
synopsis:           Agent-first CLI for browsing Hackage and Hoogle, scoped to your cabal build plan.
description:
  hypha probes a cabal project's actual build plan to answer questions about
  packages, modules, symbols, sources, and dependencies. JSON-first output for
  agents; `--human` ANSI text for terminal use; a separate `server` mode (Plan B)
  serves a browser-based offline doc viewer.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Well-Typed LLP
maintainer:         info@well-typed.com
copyright:          2026 Well-Typed LLP
category:           Development
build-type:         Simple
tested-with:        GHC == 9.6.*, GHC == 9.8.*, GHC == 9.10.*

common warnings
  ghc-options:
    -Wall
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

common deps
  default-language: GHC2021
  build-depends:    base >= 4.18 && < 5

library
  import:           warnings, deps
  hs-source-dirs:   src
  exposed-modules:
    Hypha.Prelude
    Hypha.Types.PackageId
    Hypha.Types.SymbolPath
    Hypha.Types.BuildPlan
    Hypha.Types.Doc
    Hypha.BuildEnv.Type
    Hypha.BuildEnv.Cabal
    Hypha.BuildEnv.Mock
    Hypha.BuildEnv.Compose
    Hypha.BuildEnv.Nix
    Hypha.Error
    Hypha.Exit
    Hypha.Output.Outcome
    Hypha.Mcp.Server
    Hypha.Output.Actions
    Hypha.Output.Json
    Hypha.Output.Human
    Hypha.Project.Discovery
    Hypha.Project.Plan
    Hypha.Project.Overrides
    Hypha.Cache
    Hypha.Hackage.Types
    Hypha.Hackage.Cache
    Hypha.Hackage.Api
    Hypha.Hoogle.Type
    Hypha.Hoogle.Database
    Hypha.Hoogle.Query
    Hypha.Haddock.Generate
    Hypha.Cli.Parser
    Hypha.Cli.Run
    Hypha.Command.Doctor
    Hypha.Command.Module
    Hypha.Command.Deps
    Hypha.Command.Package
    Hypha.Command.Search
    Hypha.Command.Server
    Hypha.Command.Source
    Hypha.Command.Symbol
    Hypha.Command.Versions
    Hypha.Command.WhatProvides
    Hypha.Haddock.Interface
    Hypha.Logging
    Hypha.Server.Assets
    Hypha.Server.Slots
    Hypha.Server.Haddock.Rewrite
    Hypha.Server.Ui.Layout
    Hypha.Server.Ui.Search
    Hypha.Server.Ui.Tree
    Hypha.Server.Ui.Doc
    Hypha.Server.Api
    Hypha.Server.App
    Hypha.Server.Ui.Source
    Hypha.Package.Resolver
    Hypha.Source.Extract
    Hypha.Source.Locate
    Hypha.Hackage.Source
  build-depends:
    , aeson              >= 2.0
    , aeson-pretty       >= 0.8
    , base               >= 4.18 && < 5
    , bytestring         >= 0.11
    , cabal-plan         >= 0.7
    , containers         >= 0.6
    , cryptohash-sha256  >= 0.11
    , deepseq            >= 1.4
    , directory          >= 1.3
    , filepath           >= 1.4
    , http-client        >= 0.7
    , http-media         >= 0.8
    , http-client-tls    >= 0.3
    , http-types         >= 0.12
    , haddock-library     >= 1.11
    , hoogle             >= 5.0 && < 6
    , optparse-applicative >= 0.18
    , async                 >= 2.2
    , file-embed            >= 0.0.16
    , lucid2                >= 0.0.20210901
    , prettyprinter         >= 1.7
    , servant               >= 0.20
    , servant-server        >= 0.20
    , process               >= 1.6
    , wai                   >= 3.2
    , warp                  >= 3.3
    , prettyprinter-ansi-terminal >= 1.1
    , skylighting           >= 0.14
    , tagsoup               >= 0.14
    , text                  >= 2.0
    , time                  >= 1.12
    , transformers          >= 0.6
    , typed-process         >= 0.2
    , vector                >= 0.13

executable hypha
  import:           warnings, deps
  hs-source-dirs:   app/hypha
  main-is:          Main.hs
  build-depends:    hypha
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

executable hypha-mcp
  import:           warnings, deps
  hs-source-dirs:   app/hypha-mcp
  main-is:          Main.hs
  build-depends:    hypha

test-suite hypha-tests
  import:           warnings, deps
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Golden.Package
    Golden.Search
    Golden.Server
    Golden.Symbol
    Golden.Human
    Golden.Versions
    Golden.Source
    Property.HackageCache
    Property.OutputJson
    Property.SymbolPath
    Unit.BuildEnv
    Unit.BuildEnvCompose
    Unit.Doctor
    Unit.Hackage
    Unit.Hoogle
    Unit.Module
    Unit.Deps
    Unit.Project
    Unit.WhatProvides
    Unit.Haddock
    Unit.Server
    Unit.ServerSlots
    Property.HaddockRewrite
    Unit.Mcp
  build-depends:
    , aeson
    , async
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , hypha
    , lucid2
    , prettyprinter
    , prettyprinter-ansi-terminal
    , tasty
    , tasty-golden
    , tasty-hunit
    , falsify
    , temporary
    , text
    , time
    , vector
