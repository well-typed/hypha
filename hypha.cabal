  -- Make the freshly-built executables available on $PATH for the
  -- end-to-end Golden.Cli and Golden.Encoding tests.  Without this, an
  -- end-to-end test would either see a stale system binary or have to
  -- dig through dist-newstyle by itself.
  build-tool-depends: hypha:hypha, hypha:hypha-mcp
