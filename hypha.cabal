  build-depends:
    , aeson                       >= 2.0
    , aeson-pretty                >= 0.8
    , aeson-yaml                  >= 1.1
    , async                       >= 2.2
    , base16-bytestring           >= 1.0
    , base                        >= 4.18 && < 5
    , bytestring                  >= 0.11
    , cabal-plan                  >= 0.7
    , Cabal-syntax                >= 3.10 && < 3.20
    , containers                  >= 0.6
    , cpphs                       >= 1.20
    , cryptohash-sha256           >= 0.11
    , deepseq                     >= 1.4
    , directory                   >= 1.3
    , file-embed                  >= 0.0.16
    , filepath                    >= 1.4
    , ghc-lib-parser              >= 9.10 && < 9.13
    , haddock-library             >= 1.11
    , hoogle                      >= 5.0 && < 6
    , http-client                 >= 0.7
    , http-client-tls             >= 0.3
    , http-media                  >= 0.8
    , http-types                  >= 0.12
    , iproute                     >= 1.7
    , lucid2                      >= 0.0.20210901
    , mtl
    , network                     >= 3.1
    , network-uri                 >= 2.6
    , optparse-applicative        >= 0.18
    , pretty                      >= 1.0
    , prettyprinter               >= 1.7
    , prettyprinter-ansi-terminal >= 1.1
    , process                     >= 1.6
    , safe-exceptions             >= 0.1
    , scientific                  >= 0.3
    , servant                     >= 0.20
    , servant-server              >= 0.20
    , skylighting                 >= 0.14
    , sqlite-simple               >= 0.4
    , tagsoup                     >= 0.14
    , tar                         >= 0.5
    , text                        >= 2.0
    , time                        >= 1.12
    , transformers                >= 0.6
    , typed-process               >= 0.2
    , vector                      >= 0.13
    , wai                         >= 3.2
    , warp                        >= 3.3
    , zlib                        >= 0.6

executable hypha
  import:           warnings, deps
  hs-source-dirs:   app/hypha
  main-is:          Main.hs
  build-depends:
    , hypha
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

executable hypha-mcp
  import:           warnings, deps
  hs-source-dirs:   app/hypha-mcp
  main-is:          Main.hs
  build-depends:
    , hypha
    , safe-exceptions       >= 0.1

