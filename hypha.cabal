cabal-version:      3.4
name:               hypha
version:            0.2.0
synopsis:           Agent-first CLI for browsing Hackage and Hoogle, scoped to your cabal build plan.
description:
  hypha probes a cabal project's actual build plan to answer questions about
  packages, modules, symbols, sources, and dependencies. YAML-first output for
  agents; `--json` for machine pipelines; a separate `server` mode (Plan B)
  serves a browser-based offline doc viewer.
license:            BSD-3-Clause
license-file:       LICENSE
extra-doc-files:    CHANGELOG.md
                    README.md
author:             Well-Typed LLP
maintainer:         info@well-typed.com
copyright:          2026 Well-Typed LLP
category:           Development
build-type:         Simple
tested-with:        GHC == 9.6.7, GHC == 9.10.3, GHC == 9.12.4
data-files:
  ui/css/base.css
  ui/css/layout.css
  ui/css/components/doc.css
  ui/css/components/haddock.css
  ui/css/components/progress.css
  ui/css/components/search.css
  ui/css/components/tree.css
  ui/js/htmx.min.js
  ui/js/keybindings.js
  ui/js/theme.js
  ui/icons/module.svg
  ui/icons/package.svg
  ui/icons/search.svg

common warnings
  ghc-options:
    -Wall
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

common deps
  default-language: GHC2021
  build-depends:    base >= 4.18 && < 5

