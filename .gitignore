dist-newstyle/
# ...except a test fixture's plan.json, which is a test /input/ that happens
# to live where cabal would have written it.  test/fixtures/tiny-project's
# plan has been tracked past this rule since it was added; naming the
# exception keeps the next fixture from being silently left behind — a
# fixture project whose plan does not get committed is a test that passes
# locally and fails everywhere else.
!test/fixtures/*/dist-newstyle/
!test/fixtures/*/dist-newstyle/cache/
!test/fixtures/*/dist-newstyle/cache/plan.json
dist/
.hypha/
.stack-work/
.worktrees/
result
result-*
*.hi
*.o
*.dyn_hi
*.dyn_o
.ghc.environment.*
cabal.project.local
cabal.project.local~
# Written by a bare `cabal freeze`. Its pins stack on the per-GHC freeze that
# cabal.project imports and break the solver once the two diverge. Pin with
# `cabal freeze --project-file=cabal.ghc-<ver>.project` instead.
cabal.project.freeze
.HTF/
.cache/
tags
# Track team personas + goal templates; ignore the machine-written runtime sentinel.
.pi/*
!.pi/agents/
!.pi/goals/
!.pi/settings.json
.pi/team-context.md
